# Runtime provider: openai or azure_openai
AI_PROVIDER=openai

# Local OpenAI development. Copy this file to .env and populate secrets only there.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Org-machine Azure OpenAI runtime
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# PostgreSQL durable-store connection string; keep credentials in untracked .env only.
DATABASE_URL=
POSTGRES_SCHEMA=neo_sf_q_intel
SQLITE_PATH=.runtime/neo_sf_q_intel.db
OUTCOME_SQLITE_PATH=.runtime/outcome_memory.db
OUTCOME_JSON_PATH=.runtime/outcome_memory

# Append-only live evidence ledger. The profile digest is a host-owned pin; issuer keys and
# role allowlists belong only in the untracked .env on the machine that verifies receipts.
LIVE_RECEIPT_SQLITE_PATH=.runtime/live_receipts.db
LIVE_ACCEPTANCE_PROFILE_PATH=config/live-salesforce-acceptance-profile.json
LIVE_ACCEPTANCE_PROFILE_SHA256=5e4a91adbf78ffbfa6a9d973c00c8ed857e875339118324d0a590b3af1c54bb4
LIVE_PRODUCT_RECEIPT_ISSUER_ID=
LIVE_PRODUCT_RECEIPT_HMAC_KEY=
LIVE_PRODUCT_RECEIPT_ROLES=
LIVE_HOST_RECEIPT_ISSUER_ID=
LIVE_HOST_RECEIPT_HMAC_KEY=
LIVE_HOST_RECEIPT_ROLES=

# Host-owned live baseline is disabled until the fixed non-production identity and bounded
# task authority have been reviewed. These paths stay repository-relative and private state
# stays under .runtime; the JSON and target policy require exact external byte pins.
LIVE_BASELINE_ENABLED=false
LIVE_BASELINE_CONFIG_PATH=.runtime/host-live-baseline.json
LIVE_BASELINE_CONFIG_SHA256=
LIVE_TARGET_POLICY_PATH=config/live-target-policy.json
LIVE_TARGET_POLICY_SHA256=
LIVE_ASSERTION_SQLITE_PATH=.runtime/live_assertions.db
LIVE_BASELINE_SQLITE_PATH=.runtime/live_baseline.db

# Host-owned local source-validation runner. The JSON pin must match the exact
# LocalValidationRunnerPins document; artifact storage is private and immutable.
LIVE_LOCAL_VALIDATION_CONFIG_PATH=.runtime/host-local-validation.json
LIVE_LOCAL_VALIDATION_CONFIG_SHA256=
LIVE_LOCAL_VALIDATION_ARTIFACT_SQLITE_PATH=.runtime/live_local_validation_artifacts.db

# Optional host-reviewed phase applicability, disabled by default. A proposal is not
# authority. Only exact nonruntime obligations may remain UNRESOLVED for read-only baseline.
LIVE_LOCAL_VALIDATION_PHASE_POLICY_ENABLED=false
LIVE_LOCAL_VALIDATION_PHASE_POLICY_PATH=.runtime/host-local-validation-phase-policy.json
LIVE_LOCAL_VALIDATION_PHASE_POLICY_SHA256=

# Source profile. Paths must stay repository-relative and aliases are environment-specific.
# The Git repository root is distinct from the nested Salesforce DX project root.
SALESFORCE_REPOSITORY_ROOT=../SalesForceAgentApp
SALESFORCE_APP_ROOT=../SalesForceAgentApp/strategic-deal-assurance
SOURCE_MIN_CONTRACT_VERSION=1.4.0
SOURCE_REQUIRED_CAPABILITIES=api.custom.rest
CANONICAL_ONTOLOGY_PATH=config/ontology/canonical-ontology.json
SOURCE_GRAPH_PROFILE_PATH=config/source-profiles/salesforce-application-graph.json
SOURCE_GRAPH_PROFILE_SHA256=20f062050584fa4259485df0f5dc00c3ef186562495583f6c846cd9adaa6f7ae
SF_OPERATOR_ALIAS=caip-dev
SF_VP_ALIAS=caip-vp
SF_MIN_CLI_VERSION=2.148.3

# Runtime controls default to read-only execution.
ALLOW_LLM=true
ALLOW_SALESFORCE_WRITES=false
ALLOW_UI_EXECUTION=true
EVIDENCE_TOP_K=8
LOG_LEVEL=INFO

# Browser/API boundary. Five-minute default supports complete-tree capture; valid range is 30s-15m.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FOUNDATION_CAPTURE_TIMEOUT_MS=300000
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
