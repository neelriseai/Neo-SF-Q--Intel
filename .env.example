# Runtime provider: openai or azure_openai
AI_PROVIDER=openai

# Local OpenAI development. Copy this file to .env and populate secrets only there.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Org-machine Azure OpenAI runtime
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# PostgreSQL durable-store connection string; keep credentials in untracked .env only.
DATABASE_URL=
SQLITE_PATH=.runtime/neo_sf_q_intel.db
OUTCOME_SQLITE_PATH=.runtime/outcome_memory.db
OUTCOME_JSON_PATH=.runtime/outcome_memory

# Source profile. Paths must stay repository-relative and aliases are environment-specific.
SALESFORCE_APP_ROOT=../SalesForceAgentApp/strategic-deal-assurance
SOURCE_MIN_CONTRACT_VERSION=1.4.0
SOURCE_REQUIRED_CAPABILITIES=api.custom.rest
SOURCE_GRAPH_SHA256=6fc577bc0c70b1201dbbd99e6f6a6510a2018685eb89afefc4b7c5ce05098412
CANONICAL_ONTOLOGY_PATH=config/ontology/canonical-ontology.json
SOURCE_GRAPH_PROFILE_PATH=config/source-profiles/salesforce-application-graph.json
SOURCE_GRAPH_PROFILE_SHA256=4cf073120c223126be161243bb394d57b808346a8011b25730b52a8917648e10
SF_OPERATOR_ALIAS=caip-dev
SF_VP_ALIAS=caip-vp
SF_MIN_CLI_VERSION=2.148.3

# Runtime controls default to read-only execution.
ALLOW_LLM=true
ALLOW_SALESFORCE_WRITES=false
ALLOW_UI_EXECUTION=true
EVIDENCE_TOP_K=8
LOG_LEVEL=INFO
