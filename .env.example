# Runtime provider: openai or azure_openai
AI_PROVIDER=openai

# Local OpenAI development
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Org-machine Azure OpenAI runtime
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# PostgreSQL is the durable store. Never commit a populated value.
DATABASE_URL=postgresql://neo_sf_q_intel:change-me@localhost:5432/neo_sf_q_intel

# Salesforce app source is a sibling checkout by default.
SALESFORCE_APP_ROOT=../SalesForceAgentApp/strategic-deal-assurance
SF_OPERATOR_ALIAS=caip-dev
SF_VP_ALIAS=caip-vp
SF_MIN_CLI_VERSION=2.148.3

# Runtime controls
ALLOW_LLM=true
ALLOW_SALESFORCE_WRITES=false
ALLOW_UI_EXECUTION=true
EVIDENCE_TOP_K=8
LOG_LEVEL=INFO
