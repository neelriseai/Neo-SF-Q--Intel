{
  "name": "@neo/browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "playwright test tests/locator-healer.spec.ts",
    "test:worker": "playwright test tests/browser-worker.spec.ts --config=playwright.worker.config.ts",
    "test:session": "playwright test tests/salesforce-cli-session.spec.ts --config=playwright.worker.config.ts",
    "test:coordinator": "playwright test tests/salesforce-browser-coordinator.spec.ts --config=playwright.worker.config.ts",
    "test:recovery": "playwright test tests/browser-recovery.spec.ts --config=playwright.worker.config.ts",
    "test:healing-probe": "playwright test tests/healing-probe.spec.ts --config=playwright.worker.config.ts",
    "test:hour4": "playwright test tests/locator-healer.spec.ts tests/healing-probe.spec.ts tests/browser-worker.spec.ts tests/salesforce-cli-session.spec.ts tests/salesforce-browser-coordinator.spec.ts tests/browser-recovery.spec.ts tests/live-profile-cli.spec.ts tests/live-healing-cli.spec.ts --config=playwright.worker.config.ts",
    "build:live": "tsc -p tsconfig.live.json",
    "live:profile": "npm run build:live && node dist/live-profile-cli.js",
    "live:smoke": "npm run build:live && node dist/live-smoke-cli.js",
    "live:candidate-readback": "npm run build:live && node dist/live-candidate-readback-cli.js",
    "live:business-action": "npm run build:live && node dist/live-business-action-cli.js",
    "test:e2e": "playwright test tests/dashboard.spec.ts --config=playwright.e2e.config.ts",
    "live:healing": "npm run build:live && node dist/live-healing-cli.js"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.0.0",
    "typescript": "7.0.2"
  }
}
