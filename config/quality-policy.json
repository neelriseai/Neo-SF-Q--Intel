{
  "schemaVersion": "1.0.0",
  "runtimeRoots": [
    "src/neo_sf_q_intel",
    "apps/web/src",
    "packages/browser/src",
    "config/governance-policy.json",
    "config/reasoning-policy.json"
  ],
  "scanExemptPaths": [
    "config/quality-policy.json"
  ],
  "absolutePathPatterns": [
    "[A-Za-z]:\\\\Users\\\\",
    "[A-Za-z]:/Users/",
    "file://"
  ],
  "secretPatterns": [
    "(?i)\\bsk-[A-Za-z0-9_-]{20,}",
    "(?i)postgres(?:ql)?://[^\\s:@]+:[^\\s@]+@"
  ],
  "dependencyManifestPatterns": [
    "pyproject.toml",
    "requirements*.txt",
    "uv.lock",
    "poetry.lock",
    "Pipfile",
    "Pipfile.lock",
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "pnpm-lock.yaml",
    "yarn.lock"
  ],
  "approvedPersistentVectorPackages": [
    "chromadb"
  ],
  "requiredIgnoredPaths": [
    ".runtime/neo_sf_q_intel.db",
    ".runtime/chroma/index.sqlite3"
  ],
  "knownPersistentVectorPackages": [
    "chromadb",
    "pgvector",
    "qdrant-client",
    "qdrant_client",
    "pinecone",
    "weaviate-client",
    "weaviate",
    "pymilvus",
    "milvus",
    "faiss-cpu",
    "faiss-gpu",
    "faiss",
    "lancedb",
    "sqlite-vec",
    "sqlite_vec",
    "hnswlib",
    "annoy",
    "@pinecone-database/pinecone",
    "@qdrant/js-client-rest"
  ],
  "postgresVectorPatterns": [
    "(?i)create\\s+extension(?:\\s+if\\s+not\\s+exists)?\\s+(?:pg_)?vector",
    "(?i)\\b[a-z_]*(embedding|vector)[a-z_]*\\s+(double\\s+precision|real|float[48]?|numeric|jsonb|json|bytea|text|blob)(?:\\s*\\[\\s*\\])?",
    "(?i)\\b[a-z_][a-z0-9_]*\\s+vector\\s*(\\(|,|\\n)"
  ],
  "blankExampleSecrets": [
    "OPENAI_API_KEY",
    "AZURE_OPENAI_API_KEY",
    "DATABASE_URL"
  ],
  "scopeControlledPaths": [
    "config/capability-scope.json",
    "config/governance-policy.json",
    "config/quality-policy.json",
    "config/reasoning-policy.json",
    "quality/evals/retrieval-boundaries-v1.json",
    "src/neo_sf_q_intel/analysis.py",
    "src/neo_sf_q_intel/domain.py",
    "src/neo_sf_q_intel/governance.py",
    "src/neo_sf_q_intel/governance_policy.py",
    "src/neo_sf_q_intel/policy.py",
    "src/neo_sf_q_intel/retrieval.py",
    "src/neo_sf_q_intel/salesforce_source.py",
    "src/neo_sf_q_intel/salesforce_cli.py",
    "src/neo_sf_q_intel/service.py",
    "src/neo_sf_q_intel/workflow.py",
    "src/neo_sf_q_intel/mcp_server.py",
    "src/neo_sf_q_intel/observability.py",
    "apps/web/src/app/page.tsx"
  ],
  "reviewLedgerRoot": "quality/reviews/",
  "scopeReviewManifestPath": "quality/reviews/current-scope-review.json",
  "scenarioLiteralPatterns": [
    "(?i)strategic[_ -]?deal",
    "(?i)discount__c",
    "(?i)caip-(dev|vp)",
    "(?i)/sda/v[0-9]"
  ],
  "scenarioAllowedPaths": [
    ".env.example",
    "Docs/",
    "tests/",
    "packages/browser/tests/"
  ],
  "requiredCapabilityIds": [
    "source.contract-ingestion",
    "reasoning.graph-impact",
    "knowledge.evidence-graph",
    "knowledge.canonical-ontology",
    "reasoning.graph-context-compiler",
    "reasoning.graph-grounded-agent",
    "reasoning.semantic-retrieval",
    "retrieval.chromadb",
    "orchestration.multi-agent",
    "observability.agent-trace",
    "quality.test-selection",
    "automation.locator-healing",
    "governance.claim-grounding",
    "governance.release-decision",
    "governance.release-input-integrity",
    "governance.measurement-contract",
    "memory.postgresql",
    "memory.resilient-fallback",
    "memory.release-outcomes",
    "tools.mcp",
    "runtime.salesforce-live-evidence",
    "quality.live-test-execution",
    "automation.browser-worker"
  ],
  "layerImportRules": {
    "src/neo_sf_q_intel/domain.py": [
      "fastapi",
      "langgraph",
      "mcp",
      "openai",
      "psycopg",
      "playwright"
    ],
    "src/neo_sf_q_intel/api.py": [
      "psycopg",
      "subprocess"
    ],
    "src/neo_sf_q_intel/mcp_server.py": [
      "psycopg",
      "subprocess"
    ],
    "src/neo_sf_q_intel/workflow.py": [
      "fastapi",
      "mcp",
      "openai",
      "psycopg",
      "playwright",
      "subprocess"
    ]
  }
}
