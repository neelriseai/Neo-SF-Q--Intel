        "kind": {
          "const": "ACTION",
          "title": "Kind",
          "type": "string"
        },
        "objectApiName": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Objectapiname",
          "type": "string"
        },
        "action": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,199}$",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "objectApiName",
        "action"
      ],
      "title": "BrowserActionIdentity",
      "type": "object"
    },
    "BrowserFieldIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "FIELD",
          "title": "Kind",
          "type": "string"
        },
        "objectApiName": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Objectapiname",
          "type": "string"
        },
        "fieldApiName": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Fieldapiname",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "objectApiName",
        "fieldApiName"
      ],
      "title": "BrowserFieldIdentity",
      "type": "object"
    },
    "BrowserLocatorObligation": {
      "additionalProperties": false,
      "properties": {
        "obligationId": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,199}$",
          "title": "Obligationid",
          "type": "string"
        },
        "originalLocator": {
          "$ref": "#/$defs/BrowserOriginalLocator"
        },
        "semanticIdentity": {
          "discriminator": {
            "mapping": {
              "ACTION": "#/$defs/BrowserActionIdentity",
              "FIELD": "#/$defs/BrowserFieldIdentity"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BrowserFieldIdentity"
            },
            {
              "$ref": "#/$defs/BrowserActionIdentity"
            }
          ],
          "title": "Semanticidentity"
        },
        "assertions": {
          "items": {
            "enum": [
              "EDITABLE",
              "ENABLED",
              "VISIBLE"
            ],
            "type": "string"
          },
          "minItems": 2,
          "title": "Assertions",
          "type": "array"
        }
      },
      "required": [
        "obligationId",
        "originalLocator",
        "semanticIdentity",
        "assertions"
      ],
      "title": "BrowserLocatorObligation",
      "type": "object"
    },
    "BrowserLocatorRebind": {
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "$ref": "#/$defs/BrowserRecordNavigation"
        },
        "metadataDrift": {
          "$ref": "#/$defs/BrowserMetadataDrift"
        },
        "obligationPolicy": {
          "const": "COMPLETE_DECLARED_SET",
          "title": "Obligationpolicy",
          "type": "string"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/BrowserLocatorObligation"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Obligations",
          "type": "array"
        },
        "dataMutation": {
          "const": "FORBIDDEN",
          "title": "Datamutation",
          "type": "string"
        }
      },
      "required": [
        "navigation",
        "metadataDrift",
        "obligationPolicy",
        "obligations",
        "dataMutation"
      ],
      "title": "BrowserLocatorRebind",
      "type": "object"
    },
    "BrowserMetadataDrift": {
      "additionalProperties": false,
      "properties": {
        "metadataType": {
          "const": "FlexiPage",
          "title": "Metadatatype",
          "type": "string"
        },
        "member": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Member",
          "type": "string"
        },
        "componentName": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}:[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Componentname",
          "type": "string"
        },
        "componentIdentifier": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Componentidentifier",
          "type": "string"
        },
        "propertyName": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Propertyname",
          "type": "string"
        },
        "operation": {
          "const": "SET_SCALAR",
          "title": "Operation",
          "type": "string"
        },
        "baselineValue": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$",
          "title": "Baselinevalue",
          "type": "string"
        },
        "allowedPreStates": {
          "items": {
            "discriminator": {
              "mapping": {
                "ABSENT": "#/$defs/BrowserAbsentPropertyState",
                "PRESENT": "#/$defs/BrowserPresentPropertyState"
              },
              "propertyName": "state"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BrowserAbsentPropertyState"
              },
              {
                "$ref": "#/$defs/BrowserPresentPropertyState"
              }
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Allowedprestates",
          "type": "array"
        },
        "alternateValue": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$",
          "title": "Alternatevalue",
          "type": "string"
        },
        "restoration": {
          "const": "PREIMAGE_EXACT",
          "title": "Restoration",
          "type": "string"
        },
        "maximumFiles": {
          "const": 1,
          "title": "Maximumfiles",
          "type": "integer"
        },
        "maximumBytes": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Maximumbytes",
          "type": "integer"
        }
      },
      "required": [
        "metadataType",
        "member",
        "componentName",
        "componentIdentifier",
        "propertyName",
        "operation",
        "baselineValue",
        "allowedPreStates",
        "alternateValue",
        "restoration",
        "maximumFiles",
        "maximumBytes"
      ],
      "title": "BrowserMetadataDrift",
      "type": "object"
    },
    "BrowserOriginalLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ATTRIBUTE_EQUALS",
          "title": "Kind",
          "type": "string"
