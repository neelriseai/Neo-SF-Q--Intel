      "required": [
        "state",
        "value"
      ],
      "title": "BrowserPresentPropertyState",
      "type": "object"
    },
    "BrowserRecordNavigation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "DATASET_RECORD_PAGE",
          "title": "Kind",
          "type": "string"
        },
        "datasetId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Datasetid",
          "type": "string"
        },
        "objectApiName": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$",
          "title": "Objectapiname",
