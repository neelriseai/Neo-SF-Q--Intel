          "type": "array"
        },
        "maximumSeconds": {
          "maximum": 900,
          "minimum": 1,
          "title": "Maximumseconds",
          "type": "integer"
        },
        "regeneratedLocators": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Regeneratedlocators",
          "type": "array"
