        "requiredEvidencePhases": {
          "default": [
            "CANDIDATE_CHECK_ONLY",
            "DEPLOYED_CANDIDATE",
            "LIVE_BASELINE",
            "RESTORED_BASELINE"
          ],
          "items": {
            "$ref": "#/$defs/EvidencePhase"
          },
          "maxItems": 4,
          "minItems": 3,
          "title": "Requiredevidencephases",
          "type": "array"
        }
