          "type": "string"
        }
      },
      "required": [
        "kind",
        "datasetId",
        "objectApiName",
        "identityField",
        "markerField",
        "markerValue",
        "resolution"
      ],
      "title": "BrowserRecordNavigation",
      "type": "object"
    },
    "DatasetPredicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
