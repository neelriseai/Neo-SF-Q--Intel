          "pattern": "^data-[a-z][a-z0-9-]{0,63}$",
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "attribute",
        "value"
      ],
      "title": "BrowserOriginalLocator",
      "type": "object"
    },
    "BrowserPresentPropertyState": {
      "additionalProperties": false,
      "properties": {
        "state": {
