  "dependencyReceiptRule": "EACH_DEPENDENCY_PASSED_RECEIPT_IS_AN_IMPLICIT_EXACT_CURRENT_SAME_CAMPAIGN_INPUT_ROOT",
  "liveTargetPlan": {
    "schemaVersion": "1.0.0",
    "producerKind": "HOST_OWNED_LIVE_TARGET_PLAN_PRODUCER",
    "producerImplementationDigestRequired": true,
    "producerAuthority": "HOST_POLICY_INTERSECTED_WITH_VERIFIED_SOURCE",
    "sourceContractMayAuthorize": false,
    "callerMaySupplyTargets": false,
    "zeroAmbiguousDuplicateOrUnsupportedResult": "BLOCKED",
    "requiredRoots": [
      "captured source-operation profile digest",
      "verified change and semantic graph digests",
      "ontology and source-profile identities",
      "host policy identity and expiry",
      "organization classification receipt"
    ],
    "sourceOperationProfileRules": [
      "strict versioned schema with unknown and duplicate keys rejected",
      "exact captured bytes and canonical digest",
      "typed REST variables and response schema",
      "typed metadata members, obligation IDs and browser intents",
      "free-text or heuristic parsing cannot produce targets"
    ],
    "partitionRules": [
      "derive the complete target partition from current verified change, graph and mandatory obligations",
      "host policy may allow all or block with explicit denied and unmapped targets",
      "targets may not be silently dropped, substituted or reordered"
    ],
    "standardRestRules": ["exact GET operation", "response schema and byte cap"],
    "customApiRules": ["exact GET route template", "field/schema/byte cap"],
    "metadataRules": [
      "exact host-owned type/member allowlist intersected with source-derived scope",
      "no wildcard or whole-org retrieval",
      "component/file/byte/time caps",
      "secret-bearing metadata families refused",
      "fresh no-follow ignored staging with cleanup"
    ],
    "apexRules": [
      "exact complete executable method set derived from every mandatory source-derived obligation; host policy may allow all or block but never select or drop",
      "current-task test authority and execution caps",
      "queued, partial, skipped or broad-suite results cannot pass"
    ],
    "browserRules": [
      "contract-selected application intent intersected with host policy",
      "verified origin, org and actor",
      "session closure and secret non-disclosure on every terminal outcome"
    ],
    "datasetRules": [
      "independent current synthetic-dataset scope receipt supplies record values and ownership marker",
      "exact object, field projection and query predicates are host-owned and default deny",
      "broad query, list, wildcard field and non-synthetic results are blocked and redacted before evidence"
    ]
  },
  "authorityReceiptRules": {
    "independentIssuerRequired": true,
    "executionReceiptMayAuthorizeItself": false,
    "currentExpiryRequired": true,
    "exactCampaignOrgSourceBuildManifestAndOperationMatchRequired": true,
    "scopeWideningAllowed": false
  },
  "orgClassificationPolicy": {
    "schemaVersion": "1.1.0",
    "allowedNonProductionClasses": ["SANDBOX", "SCRATCH_ORG", "DEVELOPER_EDITION"],
    "blockedClasses": ["PRODUCTION", "UNKNOWN"],
    "requiredFingerprintInputs": ["ORGANIZATION_ID", "INSTANCE_HOST", "EDITION", "ENVIRONMENT_CLASS", "AUTHENTICATED_USER_ID", "AUTHENTICATED_USERNAME"],
    "aliasAloneSufficient": false,
    "isSandboxAloneSufficient": false,
    "classificationBootstrapOperation": "ORG_DISPLAY+ORGANIZATION+USERINFO_SUBJECT+ACTIVE_USER_RECONCILIATION",
    "classificationBootstrapOperationSha256": "8ab99b077a01728f6abe8c3d4c11c73d4f224d858d07308e6f62810e60490944",
    "serverSubjectObservationRequired": true,
    "repeatSubjectAndDisplayRequired": true,
    "displayAliasIsInformational": true,
    "bootstrapOutputMayLeaveHostBroker": false
  },
  "metadataRetrievalPolicy": {
    "defaultDecision": "DENY",
    "wildcardsAllowed": false,
    "wholeOrgRetrievalAllowed": false,
    "hostCapsRequired": ["COMPONENTS", "FILES", "BYTES", "SECONDS"],
    "deniedFamilies": [
      "CONNECTED_APP",
      "AUTH_PROVIDER",
      "NAMED_CREDENTIAL",
      "EXTERNAL_CREDENTIAL",
      "CERTIFICATE_OR_KEY_MATERIAL"
    ],
    "freshNoFollowIgnoredStagingRequired": true,
    "cleanupOnEveryOutcomeRequired": true,
    "rawPayloadPersistenceAllowed": false
  },
  "candidatePhaseReceiptRules": {
    "allRequiredRolesDistinct": true,
    "sameOrgCampaignCandidateDeploymentRootRequired": true,
    "currentUnexpiredReceiptsRequired": true,
    "acceptedPhase": "DEPLOYED_CANDIDATE",
    "receiptReuseAcrossBaselineAndCandidateForbidden": true,
    "gapsOrUnknownExternalStateMayPass": false
  },
  "compensationAuthorizationRules": {
    "recoveryPermitIssuedBeforeDeploymentDispatch": true,
    "exactCompensationManifestAndSyntheticDataScopeRequired": true,
    "remainingValidityMustCoverWorstCaseCampaignAndRestore": true,
    "recoveryPermitActivatedByDeploymentDispatch": true,
    "issuerAvailabilityAfterDispatchRequired": false,
    "narrowerTamperedOrExpiredPermitResult": "DEPLOYMENT_BLOCKED"
