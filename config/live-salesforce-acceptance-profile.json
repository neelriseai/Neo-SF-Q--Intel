  "missingReceiptResult": "NOT_RUN",
  "completionRule": "ALL_REQUIRED_GATES_PASSED",
  "fixtureSubstitutionPolicy": "PROHIBITED_FOR_LIVE_GATES",
  "releaseAuthorityEnabled": false,
  "evidencePhases": [
    "LIVE_BASELINE",
    "CANDIDATE_CHECK_ONLY",
    "DEPLOYED_CANDIDATE",
    "RESTORED_BASELINE"
